    {
      "from": "jm-g7-alg-n004",
      "to": "jm-g7-alg-n005",
      "type": "easily_confused",
      "note": "相反数管符号翻转，绝对值管到原点的距离，不要互相替代。"
    },
    {
      "from": "jm-g7-alg-n007",
      "to": "jm-g7-alg-n010",
      "type": "easily_confused",
      "note": "加法看同号异号「加还是减」；乘法看同号异号「正还是负」。"
    },
    {
      "from": "jm-g7-alg-n008",
      "to": "jm-g7-alg-n011",
      "type": "related",
      "note": "减法化加相反数，除法化乘倒数，都是「转化成另一种运算」。"
    },
    {
      "from": "jm-g7-alg-n012",
      "to": "jm-g7-alg-n037",
      "type": "application",
      "note": "乘方熟悉后，10 的幂用来写很大很小的数。"
    },
    {
      "from": "jm-g7-alg-n019",
      "to": "jm-g7-alg-n020",
      "type": "easily_confused",
      "note": "字母相同但次数不同，不是同类项，不能合并。"
    },
    {
      "from": "jm-g7-alg-n023",
      "to": "jm-g7-alg-n031",
      "type": "easily_confused",
      "note": "等式两边同乘负数仍相等；不等式两边同乘负数要变号。"
    },
    {
      "from": "jm-g7-alg-n026",
      "to": "jm-g7-alg-n032",
      "type": "related",
      "note": "移项在方程和不等式里都可用，但不等式还要盯系数的符号。"
    },
    {
      "from": "jm-g7-alg-n013",
      "to": "jm-g7-alg-n038",
      "type": "application",
      "note": "会精确算之后，才谈何时取近似。"
