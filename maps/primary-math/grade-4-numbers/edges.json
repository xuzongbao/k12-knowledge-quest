    {
      "from": "pm-g4-n002",
      "to": "pm-g4-n003",
      "type": "easily_confused",
      "note": "读的时候连续 0 只读一个零；写的时候每一个空位都要写 0。"
    },
    {
      "from": "pm-g4-n005",
      "to": "pm-g4-n006",
      "type": "easily_confused",
      "note": "用万改写是相等的；四舍五入得到的是近似数，和原数不一定相等。"
    },
    {
      "from": "pm-g4-n005",
      "to": "pm-g4-n007",
      "type": "related",
      "note": "用「万」作单位和用「亿」作单位，都是改计数单位、不改变相等关系。"
    },
    {
      "from": "pm-g4-n001",
      "to": "pm-g4-n007",
      "type": "related",
      "note": "万级数位排完之后，下一级是亿级：十亿、百亿、千亿。"
    },
    {
      "from": "pm-g4-n006",
      "to": "pm-g4-n013",
      "type": "application",
      "note": "四舍五入求近似数，正是乘法估算里「看成整十整百」的办法。"
    },
    {
      "from": "pm-g4-n010",
      "to": "pm-g4-n011",
      "type": "easily_confused",
      "note": "两层相乘时，每一层自己也可能进位，不要只加不进。"
    },
    {
      "from": "pm-g4-n009",
      "to": "pm-g4-n015",
      "type": "related",
      "note": "乘整十与除以整十互为口算伙伴，都可以先算前面的数字再处理 0。"
    },
    {
      "from": "pm-g4-n012",
      "to": "pm-g4-n020",
      "type": "easily_confused",
      "note": "积随一个因数变；商在除数不变时随被除数变，两者同时扩大则商不变。"
    },
    {
      "from": "pm-g4-n017",
      "to": "pm-g4-n018",
      "type": "easily_confused",
      "note": "试商是先估；乘完发现偏了，才需要调商。"
    },
    {
      "from": "pm-g4-n018",
      "to": "pm-g4-n019",
      "type": "related",
      "note": "调完商之后，还要检查这一位够不够商 1，不够就要写 0。"
    },
    {
      "from": "pm-g4-n011",
      "to": "pm-g4-n019",
      "type": "easily_confused",
      "note": "积里的 0 常来自因数有 0；商里的 0 常来自这一位不够商 1。"
    },
    {
      "from": "pm-g4-n013",
      "to": "pm-g4-n021",
      "type": "related",
      "note": "乘法估算和除法估算都是先看成整十整百，用来判断得数是否离谱。"
    },
    {
      "from": "pm-g4-n014",
      "to": "pm-g4-n022",
      "type": "easily_confused",
      "note": "「求一共、几倍」用乘；「求每份、份数」用除，故事里不要看错方向。"
    },
    {
      "from": "pm-g4-n024",
      "to": "pm-g4-n025",
      "type": "related",
      "note": "加法和乘法都有交换律、结合律；减法和除法一般不能随便换位置。"
    },
    {
      "from": "pm-g4-n025",
      "to": "pm-g4-n026",
      "type": "easily_confused",
      "note": "结合律是三个因数先乘哪两个；分配律是「和」去乘一个数，要拆开分别乘。"
    },
    {
      "from": "pm-g4-n023",
      "to": "pm-g4-n027",
      "type": "related",
      "note": "运算顺序保证算对；运算律用来把算式变得更好算。"
    },
    {
      "from": "pm-g4-n001",
      "to": "pm-g4-n029",
      "type": "related",
      "note": "整数相邻单位是十进；小数点右边继续十进，就是十分位、百分位。"
    },
    {
      "from": "pm-g4-n031",
      "to": "pm-g4-n033",
      "type": "easily_confused",
      "note": "末尾添 0 去 0，大小不变；小数点左右移动，大小会扩大或缩小。"
    },
    {
      "from": "pm-g4-n032",
      "to": "pm-g4-n033",
      "type": "related",
      "note": "比大小从高位看起；移动小数点改变的也是每一位的计数单位。"
    },
    {
      "from": "pm-g4-n034",
      "to": "pm-g4-n035",
      "type": "easily_confused",
      "note": "位数不同时仍应对齐小数点，不能改成把末尾数字上下对齐。"
    },
    {
      "from": "pm-g4-n029",
      "to": "pm-g4-n037",
      "type": "related",
      "note": "小数表示十分之几、百分之几，乘整数就是在求几个这样的小数。"
    },
    {
      "from": "pm-g4-n037",
      "to": "pm-g4-n038",
      "type": "easily_confused",
      "note": "乘整数时积的小数位数常跟因数走；除以整数时商的小数点要与被除数对齐。"
    },
    {
      "from": "pm-g4-n011",
      "to": "pm-g4-n014",
      "type": "application",
      "note": "三位数乘两位数服务于「每份同样多、求一共」的实际问题。"
    },
    {
      "from": "pm-g4-n018",
      "to": "pm-g4-n022",
      "type": "application",
      "note": "调商后的除法用来解决平均分与求份数。"
    },
    {
      "from": "pm-g4-n027",
      "to": "pm-g4-n028",
      "type": "application",
      "note": "简便运算用到需要选择运算律的综合题。"
    },
    {
      "from": "pm-g4-n034",
      "to": "pm-g4-n036",
      "type": "application",
      "note": "小数点对齐的加减用到购物、测量等短情境。"
    },
    {
      "from": "pm-g4-n036",
      "to": "pm-g4-n040",
      "type": "application",
      "note": "小数加减进入终章综合。"
    }
  ]
}
