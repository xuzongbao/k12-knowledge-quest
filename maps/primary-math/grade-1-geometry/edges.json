    {
      "from": "pm-g1-geo-n002",
      "to": "pm-g1-geo-n003",
      "type": "related",
      "note": "前后和左右都是水平方向上的位置，宜对照着说。"
    },
    {
      "from": "pm-g1-geo-n001",
      "to": "pm-g1-geo-n002",
      "type": "easily_confused",
      "note": "「上」不是「前」：上是头顶方向，前是脸朝的方向。"
    },
    {
      "from": "pm-g1-geo-n003",
      "to": "pm-g1-geo-n005",
      "type": "easily_confused",
      "note": "自己的左和「在小明左边」不是同一句话，标准不同。"
    },
    {
      "from": "pm-g1-geo-n009",
      "to": "pm-g1-geo-n010",
      "type": "related",
      "note": "长方体和正方体都有平平的面，先一起摸再比较。"
    },
    {
      "from": "pm-g1-geo-n012",
      "to": "pm-g1-geo-n013",
      "type": "related",
      "note": "圆柱和球都能滚，但球没有平平的底面。"
    },
    {
      "from": "pm-g1-geo-n009",
      "to": "pm-g1-geo-n017",
      "type": "related",
      "note": "长方形常常是长方体的一个面描下来的。"
    },
    {
      "from": "pm-g1-geo-n010",
      "to": "pm-g1-geo-n018",
      "type": "related",
      "note": "正方形常常是正方体的一个面描下来的。"
    },
    {
      "from": "pm-g1-geo-n013",
      "to": "pm-g1-geo-n021",
      "type": "easily_confused",
      "note": "球是立体，圆是平面；球的影子或杯口才更像圆。"
    },
    {
      "from": "pm-g1-geo-n010",
      "to": "pm-g1-geo-n018",
      "type": "easily_confused",
      "note": "正方体是一块，正方形是一个面，名字很像但不是同一种。"
    },
    {
      "from": "pm-g1-geo-n017",
      "to": "pm-g1-geo-n018",
      "type": "easily_confused",
      "note": "正方形四边一样长；长方形常常有一组对边更长。"
    },
    {
      "from": "pm-g1-geo-n006",
      "to": "pm-g1-geo-n025",
      "type": "application",
      "note": "搭积木时正好要用上、下、前、后来说位置。"
    },
    {
      "from": "pm-g1-geo-n024",
      "to": "pm-g1-geo-n028",
      "type": "application",
      "note": "生活里的图案也是平面图形拼出来的。"
    },
    {
      "from": "pm-g1-geo-n021",
      "to": "pm-g1-geo-n012",
      "type": "related",
      "note": "圆柱的底面看起来是圆。"
    },
    {
      "from": "pm-g1-geo-n029",
      "to": "pm-g1-geo-n024",
      "type": "related",
      "note": "对折剪纸和拼组都是在玩图形的合与分。"
    }
  ]
