    {
      "from": "pm-g6-geo-n001",
      "to": "pm-g6-geo-n002",
      "type": "related",
      "note": "正方体是长、宽、高都相等的长方体。"
    },
    {
      "from": "pm-g6-geo-n003",
      "to": "pm-g6-geo-n005",
      "type": "application",
      "note": "展开图六个面铺平，正好帮助理解和计算表面积。"
    },
    {
      "from": "pm-g6-geo-n005",
      "to": "pm-g6-geo-n009",
      "type": "easily_confused",
      "note": "表面积是六个面的总面积，体积是所占空间；单位一个是平方，一个是立方。"
    },
    {
      "from": "pm-g6-geo-n011",
      "to": "pm-g6-geo-n009",
      "type": "easily_confused",
      "note": "容积看容器里面，体积看物体本身；数字上常能换算，意思不同。"
    },
    {
      "from": "pm-g6-geo-n014",
      "to": "pm-g6-geo-n015",
      "type": "related",
      "note": "侧面展开成长方形，长是底面周长，所以侧面积 = 底面周长 × 高。"
    },
    {
      "from": "pm-g6-geo-n015",
      "to": "pm-g6-geo-n016",
      "type": "easily_confused",
      "note": "侧面积只包一圈，表面积还要加两个底；体积是底面积乘高。"
    },
    {
      "from": "pm-g6-geo-n016",
      "to": "pm-g6-geo-n018",
      "type": "easily_confused",
      "note": "等底等高时圆锥是圆柱的三分之一，不要漏乘 1/3，也不要除以 2。"
    },
    {
      "from": "pm-g6-geo-n009",
      "to": "pm-g6-geo-n016",
      "type": "related",
      "note": "柱体体积都可以看成底面积乘高，底从长方形换成圆。"
    },
    {
      "from": "pm-g6-geo-n022",
      "to": "pm-g6-geo-n023",
      "type": "related",
      "note": "放大与缩小都是相似变化：角不变，边成比例。"
    },
    {
      "from": "pm-g6-geo-n023",
      "to": "pm-g6-geo-n020",
      "type": "easily_confused",
      "note": "边长缩小到 1/2，面积缩小到 1/4，不要按同一倍数去估面积。"
    },
    {
      "from": "pm-g6-geo-n020",
      "to": "pm-g6-geo-n024",
      "type": "application",
      "note": "比例尺就是图纸把实际图形按倍数缩小后的记录方式。"
    },
    {
      "from": "pm-g6-geo-n004",
      "to": "pm-g6-geo-n014",
      "type": "related",
      "note": "展开图都是把立体的面铺到平面上，只是面的形状不同。"
    },
    {
      "from": "pm-g6-geo-n025",
      "to": "pm-g6-geo-n031",
      "type": "related",
      "note": "观察物体和路线图都是在用不同方向描述空间。"
    },
    {
      "from": "pm-g6-geo-n027",
      "to": "pm-g6-geo-n015",
      "type": "application",
      "note": "展开图看错，侧面积就会把底面周长用错。"
    }
  ]
}
