    {
      "from": "pm-g4-geo-n001",
      "to": "pm-g4-geo-n002",
      "type": "related",
      "note": "角的边是射线，先分清直线射线线段再画角。"
    },
    {
      "from": "pm-g4-geo-n003",
      "to": "pm-g4-geo-n004",
      "type": "related",
      "note": "会量才会画：画角其实是把量的过程反过来做。"
    },
    {
      "from": "pm-g4-geo-n003",
      "to": "pm-g4-geo-n006",
      "type": "easily_confused",
      "note": "量角器内外两圈刻度，要从 0 那一圈开始读，不要读成互补的那个数。"
    },
    {
      "from": "pm-g4-geo-n007",
      "to": "pm-g4-geo-n008",
      "type": "easily_confused",
      "note": "垂直一定相交成直角；平行不相交。不要把「看起来斜」当成不平行。"
    },
    {
      "from": "pm-g4-geo-n011",
      "to": "pm-g4-geo-n012",
      "type": "easily_confused",
      "note": "平行四边形两组对边都平行；梯形只有一组。"
    },
    {
      "from": "pm-g4-geo-n016",
      "to": "pm-g4-geo-n017",
      "type": "related",
      "note": "先能围成三角形，再按边是否相等分类。"
    },
    {
      "from": "pm-g4-geo-n017",
      "to": "pm-g4-geo-n018",
      "type": "related",
      "note": "按边分类和按角分类是两把尺子，同一个三角形可以同时是等腰直角。"
    },
    {
      "from": "pm-g4-geo-n021",
      "to": "pm-g4-geo-n022",
      "type": "related",
      "note": "三角形面积是等底等高平行四边形的一半。"
    },
    {
      "from": "pm-g4-geo-n021",
      "to": "pm-g4-geo-n024",
      "type": "application",
      "note": "割补前后面积不变，所以等底等高面积相等。"
    },
    {
      "from": "pm-g4-geo-n007",
      "to": "pm-g4-geo-n021",
      "type": "application",
      "note": "高必须垂直于底，作高就是画垂线。"
    },
    {
      "from": "pm-g4-geo-n027",
      "to": "pm-g4-geo-n028",
      "type": "related",
      "note": "会看三视图才能反过来搭。"
    },
    {
      "from": "pm-g4-geo-n029",
      "to": "pm-g4-geo-n030",
      "type": "easily_confused",
      "note": "轴对称是翻折，旋转是绕点转，对应点的轨迹不同。"
    },
    {
      "from": "pm-g4-geo-n015",
      "to": "pm-g4-geo-n011",
      "type": "related",
      "note": "三角形稳定、平行四边形易变形，都是边的连接方式带来的。"
    }
  ]
}
