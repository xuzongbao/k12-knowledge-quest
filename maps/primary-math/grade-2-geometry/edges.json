    {
      "from": "pm-g2-geo-n002",
      "to": "pm-g2-geo-n004",
      "type": "related",
      "note": "厘米量短的，米量长的，先建立大小感觉再换算。"
    },
    {
      "from": "pm-g2-geo-n007",
      "to": "pm-g2-geo-n009",
      "type": "related",
      "note": "分米夹在厘米和米中间；千米比米大得多，用来量路程。"
    },
    {
      "from": "pm-g2-geo-n002",
      "to": "pm-g2-geo-n008",
      "type": "easily_confused",
      "note": "厘米看直尺上的大格，毫米是大格里的小格，不要数错。"
    },
    {
      "from": "pm-g2-geo-n004",
      "to": "pm-g2-geo-n009",
      "type": "easily_confused",
      "note": "米量教室，千米量马路，不要把课桌长说成几千米。"
    },
    {
      "from": "pm-g2-geo-n012",
      "to": "pm-g2-geo-n015",
      "type": "easily_confused",
      "note": "角的大小看张开的程度，不看边画得长不长。"
    },
    {
      "from": "pm-g2-geo-n013",
      "to": "pm-g2-geo-n014",
      "type": "related",
      "note": "先钉住直角这个「标准角」，再分出更小的锐角和更大的钝角。"
    },
    {
      "from": "pm-g2-geo-n016",
      "to": "pm-g2-geo-n017",
      "type": "easily_confused",
      "note": "正方形四边相等；长方形对边相等，邻边可以不相等。"
    },
    {
      "from": "pm-g2-geo-n011",
      "to": "pm-g2-geo-n019",
      "type": "application",
      "note": "画长方形正方形时，边都是线段，要用直尺。"
    },
    {
      "from": "pm-g2-geo-n021",
      "to": "pm-g2-geo-n029",
      "type": "related",
      "note": "轴对称是对折重合，平移是整体滑动，两种运动不一样。"
    },
    {
      "from": "pm-g2-geo-n024",
      "to": "pm-g2-geo-n025",
      "type": "easily_confused",
      "note": "正面、侧面、上面看到的轮廓常常不同，不能只用一个方向猜。"
    },
    {
      "from": "pm-g2-geo-n027",
      "to": "pm-g2-geo-n003",
      "type": "related",
      "note": "方向和长度都是在空间里给物体定位：一个说朝哪，一个说有多长。"
    },
    {
      "from": "pm-g2-geo-n006",
      "to": "pm-g2-geo-n020",
      "type": "application",
      "note": "解决问题前先估一估用哪个单位更合适。"
    },
    {
      "from": "pm-g2-geo-n015",
      "to": "pm-g2-geo-n016",
      "type": "related",
      "note": "长方形四个角都是直角，认角是认长方形的基础。"
    }
  ]
}
