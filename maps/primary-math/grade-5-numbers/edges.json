    {
      "from": "pm-g5-n001",
      "to": "pm-g5-n002",
      "type": "easily_confused",
      "note": "先按整数乘只是中间步骤；积的小数点要按因数一共有几位小数来点。"
    },
    {
      "from": "pm-g5-n002",
      "to": "pm-g5-n003",
      "type": "related",
      "note": "小数乘小数仍然用「因数一共几位小数，积就先点几位」。"
    },
    {
      "from": "pm-g5-n003",
      "to": "pm-g5-n007",
      "type": "easily_confused",
      "note": "乘法看因数的小数位数点积；除法里商的小数点要与被除数对齐。"
    },
    {
      "from": "pm-g5-n007",
      "to": "pm-g5-n008",
      "type": "easily_confused",
      "note": "除数是小数时，被除数和除数要同时扩大相同倍数，不能只移动一边。"
    },
    {
      "from": "pm-g5-n005",
      "to": "pm-g5-n009",
      "type": "related",
      "note": "积的近似值和商的近似值都用四舍五入，先看题目要保留到哪一位。"
    },
    {
      "from": "pm-g5-n009",
      "to": "pm-g5-n010",
      "type": "easily_confused",
      "note": "求近似值是四舍五入截取；循环小数是除不尽时用循环节表示精确商。"
    },
    {
      "from": "pm-g5-n004",
      "to": "pm-g5-n011",
      "type": "application",
      "note": "运算律可以让小数混合运算先凑整，再按顺序算。"
    },
    {
      "from": "pm-g5-n006",
      "to": "pm-g5-n012",
      "type": "application",
      "note": "小数乘法故事进入乘除综合关。"
    },
    {
      "from": "pm-g5-n013",
      "to": "pm-g5-n014",
      "type": "easily_confused",
      "note": "因数是「谁乘谁得到它」；倍数是「它是谁的几倍」，方向不要说反。"
    },
    {
      "from": "pm-g5-n013",
      "to": "pm-g5-n016",
      "type": "related",
      "note": "看一个数有几个因数，就能分辨它是质数还是合数。"
    },
    {
      "from": "pm-g5-n016",
      "to": "pm-g5-n017",
      "type": "related",
      "note": "分解质因数就是把合数拆成质数相乘。"
    },
    {
      "from": "pm-g5-n018",
      "to": "pm-g5-n019",
      "type": "easily_confused",
      "note": "最大公因数不会比两个数中较小的那个大；最小公倍数不会比它们中较大的那个小。"
    },
    {
      "from": "pm-g5-n018",
      "to": "pm-g5-n024",
      "type": "application",
      "note": "约分时要找分子分母的最大公因数。"
    },
    {
      "from": "pm-g5-n019",
      "to": "pm-g5-n025",
      "type": "application",
      "note": "通分时常取分母的最小公倍数作公分母。"
    },
    {
      "from": "pm-g5-n021",
      "to": "pm-g5-n026",
      "type": "related",
      "note": "分数表示整数相除的商，所以可以和小数互相改写。"
    },
    {
      "from": "pm-g5-n023",
      "to": "pm-g5-n024",
      "type": "easily_confused",
      "note": "基本性质是「同时乘或除以同一个不为 0 的数」；约分是用它化成最简。"
    },
    {
      "from": "pm-g5-n024",
      "to": "pm-g5-n025",
      "type": "easily_confused",
      "note": "约分是缩小分子分母；通分是扩大分子分母，使分母相同。"
    },
    {
      "from": "pm-g5-n027",
      "to": "pm-g5-n028",
      "type": "easily_confused",
      "note": "同分母直接加减分子；异分母必须先通分，不能分母、分子分别加减。"
    },
    {
      "from": "pm-g5-n012",
      "to": "pm-g5-n026",
      "type": "related",
      "note": "小数乘除里见过的有限小数，这里再和分数对照着写。"
    },
    {
      "from": "pm-g5-n028",
      "to": "pm-g5-n030",
      "type": "application",
      "note": "异分母加减用到「一共、还剩」的分数故事。"
    },
    {
      "from": "pm-g5-n033",
      "to": "pm-g5-n034",
      "type": "related",
      "note": "方程是特殊的等式，解方程靠的是等式两边同加同减、同乘同除。"
    },
    {
      "from": "pm-g5-n035",
      "to": "pm-g5-n036",
      "type": "application",
      "note": "会解方程之后，才能在短故事里设未知数并列方程。"
    },
    {
      "from": "pm-g5-n032",
      "to": "pm-g5-n004",
      "type": "related",
      "note": "用字母表示运算律，和「运算律推广到小数」说的是同一件事。"
    },
    {
      "from": "pm-g5-n031",
      "to": "pm-g5-n037",
      "type": "application",
      "note": "分数加减进入终章综合。"
    }
  ]
}
