    {
      "from": "pm-g6-n001",
      "to": "pm-g6-n004",
      "type": "related",
      "note": "分数乘法的意义，核心就是「求一个数的几分之几」。"
    },
    {
      "from": "pm-g6-n003",
      "to": "pm-g6-n006",
      "type": "related",
      "note": "会乘分数之后，倒数就是「乘谁得 1」。"
    },
    {
      "from": "pm-g6-n004",
      "to": "pm-g6-n009",
      "type": "easily_confused",
      "note": "求几分之几用乘；已知几分之几求原数用除。单位 1 不要找错。"
    },
    {
      "from": "pm-g6-n006",
      "to": "pm-g6-n008",
      "type": "application",
      "note": "除以一个分数，就是乘它的倒数。"
    },
    {
      "from": "pm-g6-n007",
      "to": "pm-g6-n008",
      "type": "easily_confused",
      "note": "除以整数：乘 1/整数；除以分数：乘这个分数的倒数。不要分子分母颠倒除数以外的数。"
    },
    {
      "from": "pm-g6-n005",
      "to": "pm-g6-n011",
      "type": "easily_confused",
      "note": "同样说「几分之几」，有的是已知单位 1 求部分，有的是已知部分求单位 1。"
    },
    {
      "from": "pm-g6-n013",
      "to": "pm-g6-n016",
      "type": "related",
      "note": "比值就是前项除以后项的商，和除法、分数是一家。"
    },
    {
      "from": "pm-g6-n014",
      "to": "pm-g6-n015",
      "type": "easily_confused",
      "note": "基本性质保证比值不变；化简比是用它把前后项化成互质整数。"
    },
    {
      "from": "pm-g6-n015",
      "to": "pm-g6-n017",
      "type": "application",
      "note": "按比分配前，常常先把比化成最简整数比，再数总份数。"
    },
    {
      "from": "pm-g6-n013",
      "to": "pm-g6-n019",
      "type": "related",
      "note": "百分数可以看成后项是 100 的比，专门用来比较。"
    },
    {
      "from": "pm-g6-n016",
      "to": "pm-g6-n018",
      "type": "application",
      "note": "比例尺就是图上距离与实际距离的比，比值写成分数或 1∶n。"
    },
    {
      "from": "pm-g6-n004",
      "to": "pm-g6-n021",
      "type": "related",
      "note": "求一个数的百分之几，和求一个数的几分之几是同一类乘法。"
    },
    {
      "from": "pm-g6-n009",
      "to": "pm-g6-n022",
      "type": "related",
      "note": "已知百分之几求原数，和已知几分之几求原数是同一类除法。"
    },
    {
      "from": "pm-g6-n021",
      "to": "pm-g6-n022",
      "type": "easily_confused",
      "note": "求百分之几是多少用乘；已知百分之几求单位 1 用除。"
    },
    {
      "from": "pm-g6-n023",
      "to": "pm-g6-n025",
      "type": "application",
      "note": "百分率是「部分÷总数」，再写成百分数去比较。"
    },
    {
      "from": "pm-g6-n020",
      "to": "pm-g6-n024",
      "type": "related",
      "note": "几折、税率、利率都要先化成百分数或小数再算。"
    },
    {
      "from": "pm-g6-n015",
      "to": "pm-g6-n026",
      "type": "related",
      "note": "两个最简比的比值相等，就可以写成比例。"
    },
    {
      "from": "pm-g6-n026",
      "to": "pm-g6-n027",
      "type": "easily_confused",
      "note": "比例是两个比相等；解比例是求其中一项未知数。"
    },
    {
      "from": "pm-g6-n028",
      "to": "pm-g6-n029",
      "type": "easily_confused",
      "note": "正比例看比值一定；反比例看积一定。不要只看「一个变大一个也变大」。"
    },
    {
      "from": "pm-g6-n030",
      "to": "pm-g6-n031",
      "type": "application",
      "note": "判断成正比例还是反比例之后，才能列比例求未知量。"
    },
    {
      "from": "pm-g6-n033",
      "to": "pm-g6-n034",
      "type": "related",
      "note": "负号表示相反意义；0 是正负数中间的分界，本身不带正负。"
    },
    {
      "from": "pm-g6-n034",
      "to": "pm-g6-n035",
      "type": "easily_confused",
      "note": "−8 比 −3 小，因为更靠「负」的一侧；不要看成 8 比 3 大就判定 −8 更大。"
    },
    {
      "from": "pm-g6-n011",
      "to": "pm-g6-n036",
      "type": "application",
      "note": "分数乘除故事也可以改用设未知数、列方程来解。"
    },
    {
      "from": "pm-g6-n025",
      "to": "pm-g6-n037",
      "type": "application",
      "note": "百分数里单位 1 未知时，设方程往往更清楚。"
    },
    {
      "from": "pm-g6-n032",
      "to": "pm-g6-n038",
      "type": "application",
      "note": "比、百分数、比例进入终章综合。"
    }
  ]
}
